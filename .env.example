# Use the browser's exact origin (including port); keep localhost/127.0.0.1 consistent.
PUBLIC_ORIGIN=http://127.0.0.1:5173
ENV=dev
# Optional absolute persistent local data path:
# DATA_DIR=/srv/chatldt/data
# DATABASE_URL=sqlite:////srv/chatldt/data/webui.db
# Optional persistent server key; otherwise generated in DATA_DIR/.webui_secret_key.
# WEBUI_SECRET_KEY=

# Optional Google Cloud OAuth Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/oauth/google/callback

# ONLY used to name conversations from the first successfully sent text snapshot.
OPENAI_API_KEY=
OPENAI_TITLE_MODEL=gpt-4o-mini

# Current public HTTPS deployment (use these instead of the development values above):
# PUBLIC_ORIGIN=https://chat.eurse.me
# ENV=prod
# GOOGLE_REDIRECT_URI=https://chat.eurse.me/oauth/google/callback
# Restart the backend after changing .env; process environment variables take precedence.

# Additional exact browser origins, comma-separated. Canonical PUBLIC_ORIGIN is always accepted.
# ALLOWED_ORIGINS=https://chat.eurse.me,https://eurse.me
