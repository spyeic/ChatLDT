{
	"name": "chatldt",
	"version": "0.13.3",
	"private": true,
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"dev": "vite dev --host 127.0.0.1",
		"backend:dev": "node scripts/backend.mjs dev",
		"start": "node scripts/backend.mjs serve",
		"password:reset": "node scripts/backend.mjs reset",
		"db:migrate": "node scripts/backend.mjs migrate",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:frontend": "vitest run",
		"test:backend": "node scripts/backend.mjs test",
		"format": "prettier --write src scripts docs README.md package.json vite.config.ts",
		"backup": "node scripts/backend.mjs backup",
		"test:browser": "node scripts/browser-smoke.mjs",
		"prebuild": "node scripts/licenses.mjs",
		"predev": "node scripts/licenses.mjs",
		"test:ui": "node scripts/ui-polish-smoke.mjs",
		"test:mobile": "node scripts/mobile-layout-smoke.mjs",
		"test:chat-style": "node scripts/chat-style-smoke.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.2",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/postcss": "^4.0.0",
		"@tailwindcss/typography": "^0.5.13",
		"postcss": "^8.4.31",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.53.10",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^5.5.4",
		"vite": "^5.4.21",
		"vitest": "^1.6.1",
		"playwright": "1.60.0"
	},
	"type": "module",
	"dependencies": {
		"dompurify": "^3.4.17",
		"highlight.js": "^11.9.0",
		"i18next": "^23.10.0",
		"katex": "^0.16.22",
		"marked": "^9.1.0",
		"socket.io-client": "^4.8.3"
	},
	"engines": {
		"node": ">=18.13.0 <=22.x.x",
		"npm": ">=6.0.0"
	}
}
